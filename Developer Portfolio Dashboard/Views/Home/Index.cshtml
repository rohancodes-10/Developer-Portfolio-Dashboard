@model HomeViewModel
<div class="text-center mt-5">
    <h1>Developer portfolio Dashboard</h1>
    <p class="text-muted">Login with Github to view your portfolio</p>
    <a href="/auth/login" class="btn btn-dark btn-lg">Login with GitHub</a>
</div>

@if (Model.user!= null)
{
    <p>Logged in as: @Model.user.Name (@Model.user.Login)</p>
    <p>Public repos: @Model.user.PublicRepos</p>

    foreach (var repo in @Model.Repos)
    {
        <p>@repo.Name — ⭐ @repo.Stars</p>
    }
}